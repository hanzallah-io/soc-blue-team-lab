# Detects Nmap SYN scan — SYN flag set alone, TCP flags check via 'flags:S,12'
# A normal handshake sends SYN then completes with ACK; a scan often sends
# bursts of bare SYN packets to many ports without completing the handshake.
alert tcp any any -> $HOME_NET any (msg:"CUSTOM Nmap SYN Scan Detected"; flags:S; threshold:type both, track by_src, count 20, seconds 3; sid:1000001; rev:1; classtype:attempted-recon;)

# Detects HTTP directory traversal attempt — repeated ../ sequences in URI
# indicate an attacker probing for path traversal to access files outside
# the intended web root.
alert http any any -> $HOME_NET any (msg:"CUSTOM HTTP Directory Traversal Attempt"; flow:to_server,established; http.uri.raw; content:"../../../"; sid:1000002; rev:2; classtype:web-application-attack;)

# Detects ICMP flood — more than 50 ICMP echo requests from one source
# within 2 seconds. A single ping is routine network activity; a burst
# at this rate is consistent with a denial-of-service attempt.
alert icmp any any -> $HOME_NET any (msg:"CUSTOM ICMP Flood Detected"; itype:8; threshold:type both, track by_src, count 50, seconds 2; sid:1000003; rev:1; classtype:attempted-dos;)
